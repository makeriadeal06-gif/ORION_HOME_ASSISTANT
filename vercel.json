{
  "version": 2,
  "functions": {
    "api/server.cjs": {
      "runtime": "nodejs",
      "includeFiles": "dist/server.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
